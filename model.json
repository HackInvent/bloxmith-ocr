{
  "kind": "ocr",
  "version": "0.1.0",
  "title": "OCR",
  "description": "Recognize text from local images and PDF pages, with word positions, confidence and explicit review issues.",
  "repository_url": "https://github.com/HackInvent/bloxmith-ocr",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "python_distribution",
      "name": "Pillow",
      "version": ">=10.2"
    },
    {
      "type": "manual",
      "name": "Install all configured Tesseract language packs in the runtime environment."
    },
    {
      "type": "executable",
      "name": "tesseract"
    },
    {
      "type": "executable",
      "name": "pdftoppm"
    },
    {
      "type": "executable",
      "name": "pdfinfo"
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "document",
        "title": "document",
        "accepts": [
          "application/json",
          "text/plain",
          "file/path",
          "message/*"
        ],
        "multiplicity": "one",
        "required": true,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "text",
        "title": "text",
        "emits": [
          "text/plain",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "pages",
        "title": "pages",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "issues",
        "title": "issues",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "allowed_root": "",
    "languages": [
      "eng"
    ],
    "first_page": 1,
    "last_page": 0,
    "dpi": 200,
    "page_segmentation": 3,
    "confidence_threshold": 70,
    "max_pages": 20,
    "max_bytes": 20971520,
    "max_characters": 300000,
    "timeout_sec": 120
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs",
    "file_browser": true
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
